# انسخ هذا الملف إلى .env.local وعبّئ القيم الحقيقية — ولا ترفع أي قيمة حقيقية إلى Git

# قاعدة بيانات Turso (إلزامي)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# خدمة دمج الفيديو Video Merger API v2 (مطلوبة لأداة merge_videos)
MERGER_API_BASE=https://<your-merger-service>

# اختياري: حماية مسار /mcp بمفتاح Bearer
# MCP_ACCESS_TOKEN=

# اختياري: سقف نافذة الانتظار داخل الاستدعاء الواحد بالثواني (الافتراضي 50 لحدود دوال Vercel)
# MCP_MAX_WAIT_SECONDS=50

# اختياري: تجاوز أسماء الموديلات لدى كل مزود
# KIE_IMAGE_MODEL=
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=

# للتجارب فقط: تجاوز عنوان kie الأساسي (لا تستخدمه في الإنتاج)
# KIE_API_BASE=
